{
	"info": {
		"_postman_id": "8237d219-567e-437d-ba43-dd5023e5fe9d",
		"name": "TODO API - Manual Testing",
		"description": "Manual testing collection for TODO API. Includes login saving token for authorized requests.",
		"schema": "https://schema.getpostman.com/json/collection/v2.0.0/collection.json",
		"_exporter_id": "33056082"
	},
	"item": [
		{
			"name": "Register",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"user{{randomInt}}@test.com\",\n  \"password\": \"123456\",\n  \"name\": \"User {{randomInt}}\"\n}"
				},
				"url": "{{baseUrl}}/api/auth/register"
			},
			"response": []
		},
		{
			"name": "Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.token) {",
							"    pm.environment.set('token', jsonData.token);",
							"    console.log('Token salvato:', jsonData.token);",
							"} else {",
							"    console.warn('Nessun token trovato nella risposta');",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"user1@test.com\",\n  \"password\": \"123456\"\n}"
				},
				"url": "{{baseUrl}}/api/auth/login"
			},
			"response": []
		},
		{
			"name": "Get Current User",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": "{{baseUrl}}/api/users/me"
			},
			"response": []
		},
		{
			"name": "Update User Name",
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Updated User\"\n}"
				},
				"url": "{{baseUrl}}/api/users/me"
			},
			"response": []
		},
		{
			"name": "Create Task",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.id) {",
							"    pm.environment.set('taskId', jsonData.id);",
							"    console.log('Task ID salvato:', jsonData.id);",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"My first task\",\n  \"title\": \"Task esempio4\"\n}"
				},
				"url": "{{baseUrl}}/api/tasks"
			},
			"response": []
		},
		{
			"name": "Get All Tasks",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": "{{baseUrl}}/api/tasks"
			},
			"response": []
		},
		{
			"name": "Get Task by ID",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": "{{baseUrl}}/api/tasks/{{taskId}}"
			},
			"response": []
		},
		{
			"name": "Update Task",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Updated Task Name\"\n}"
				},
				"url": "{{baseUrl}}/api/tasks/{{taskId}}"
			},
			"response": []
		},
		{
			"name": "Delete Task",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": "{{baseUrl}}/api/tasks/{{taskId}}"
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:4000"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "taskId",
			"value": ""
		}
	]
}